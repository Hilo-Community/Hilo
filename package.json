{
  "name": "coloride-monorepo",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @coloride/desktop-tauri tauri dev",
    "dev:web": "pnpm --filter @coloride/desktop-tauri dev",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b",
    "test": "pnpm -r test",
    "fetch:js-debug": "node scripts/fetch-js-debug.mjs",
    "build": "tsc -b && pnpm --filter @coloride/web-ui build && pnpm --filter @coloride/desktop-tauri build",
    "test:performance": "vitest run --config vitest.performance.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tauri-apps/cli": "2.12.4",
    "@vtsls/language-server": "0.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "5.7.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  }
}
