{
  "providers": [
    {
      "id": "openai",
      "name": "OpenAI",
      "protocol": "openai",
      "upstream": "https://api.openai.com/v1",
      "keyHeader": "authorization",
      "keyPrefix": "Bearer ",
      "accountHosts": ["auth.openai.com", "api.openai.com", "chatgpt.com", "ab.chatgpt.com"]
    },
    {
      "id": "anthropic",
      "name": "Anthropic",
      "protocol": "anthropic",
      "upstream": "https://api.anthropic.com",
      "keyHeader": "x-api-key",
      "keyPrefix": "",
      "accountHosts": [
        "claude.ai",
        "claude.com",
        "console.anthropic.com",
        "platform.claude.com",
        "api.anthropic.com"
      ]
    },
    {
      "id": "google",
      "name": "Google",
      "protocol": "google",
      "upstream": "https://generativelanguage.googleapis.com",
      "keyHeader": "x-goog-api-key",
      "keyPrefix": "",
      "accountHosts": [
        "accounts.google.com",
        "oauth2.googleapis.com",
        "generativelanguage.googleapis.com"
      ]
    },
    {
      "id": "xai",
      "name": "xAI",
      "protocol": "openai",
      "upstream": "https://api.x.ai/v1",
      "keyHeader": "authorization",
      "keyPrefix": "Bearer ",
      "accountHosts": ["auth.x.ai", "cli-chat-proxy.grok.com", "api.x.ai", "grok.com"]
    },
    {
      "id": "qwen",
      "name": "Qwen",
      "protocol": "openai",
      "upstream": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "keyHeader": "authorization",
      "keyPrefix": "Bearer ",
      "accountHosts": [
        "chat.qwen.ai",
        "auth.qwen.ai",
        "api.qwen.ai",
        "portal.qwen.ai",
        "dashscope.aliyuncs.com",
        "dashscope-intl.aliyuncs.com",
        "coding.dashscope.aliyuncs.com",
        "coding-intl.dashscope.aliyuncs.com",
        "maas.qwencloudapi.com",
        "token-plan.maas.qwencloudapi.com",
        "maas.qianwenaiapi.com",
        "token-plan.maas.qianwenaiapi.com"
      ]
    },
    {
      "id": "bob",
      "name": "IBM Bob",
      "protocol": "openai",
      "upstream": "https://api.us-east.bob.ibm.com",
      "keyHeader": "authorization",
      "keyPrefix": "Bearer ",
      "accountHosts": [
        "bob.ibm.com",
        "api.us-east.bob.ibm.com",
        "internal.bob.ibm.com",
        "iam.cloud.ibm.com",
        "iam.platform.saas.ibm.com",
        "myibm.ibm.com",
        "cloud.ibm.com",
        "www.ibm.com"
      ]
    }
  ],
  "agents": [
    {
      "id": "codex-acp",
      "providers": ["openai"],
      "homeVariables": {
        "CODEX_HOME": ".codex"
      },
      "environment": {},
      "loginCallbackPorts": [1455],
      "setup": [
        {
          "path": ".codex/config.toml",
          "content": "sandbox_mode = \"danger-full-access\"\napproval_policy = \"never\"\n"
        }
      ],
      "baseUrlVariables": {},
      "tokenVariables": {},
      "accountMethods": ["chat-gpt-device-code"],
      "preferenceDomains": ["com.openai.codex"]
    },
    {
      "id": "claude-acp",
      "providers": ["anthropic"],
      "homeVariables": {
        "CLAUDE_CONFIG_DIR": ".claude",
        "CLAUDE_CODE_TMPDIR": ".claude-tmp"
      },
      "environment": {
        "DISABLE_AUTOUPDATER": "1",
        "DISABLE_TELEMETRY": "1",
        "DISABLE_ERROR_REPORTING": "1"
      },
      "setup": [],
      "baseUrlVariables": {
        "anthropic": ["ANTHROPIC_BASE_URL"]
      },
      "tokenVariables": {
        "anthropic": ["ANTHROPIC_AUTH_TOKEN"]
      },
      "accountMethods": ["claude-ai-login", "claude-login", "terminal-auth"]
    },
    {
      "id": "opencode",
      "providers": ["openai", "anthropic", "google", "xai"],
      "homeVariables": {},
      "environment": {
        "OPENCODE_DISABLE_AUTOUPDATE": "1",
        "NO_BROWSER": "1"
      },
      "setup": [],
      "baseUrlVariables": {},
      "tokenVariables": {},
      "accountMethods": ["terminal-auth"]
    },
    {
      "id": "grok-build",
      "providers": ["xai"],
      "homeVariables": {
        "GROK_HOME": ".grok"
      },
      "environment": {
        "GROK_DISABLE_AUTOUPDATER": "1",
        "GROK_SANDBOX": "off",
        "NO_BROWSER": "1"
      },
      "setup": [],
      "baseUrlVariables": {
        "xai": ["GROK_MODELS_BASE_URL", "GROK_XAI_API_BASE_URL"]
      },
      "tokenVariables": {
        "xai": ["XAI_API_KEY"]
      },
      "accountMethods": ["grok.com"]
    },
    {
      "id": "qwen-code",
      "providers": ["qwen", "openai", "anthropic", "google"],
      "homeVariables": {
        "QWEN_HOME": ".qwen"
      },
      "environment": {
        "NO_BROWSER": "1",
        "OPENAI_MODEL": "qwen3-coder-plus",
        "QWEN_SANDBOX": "false",
        "QWEN_USAGE_STATISTICS_ENABLED": "false"
      },
      "setup": [],
      "baseUrlVariables": {
        "qwen": ["OPENAI_BASE_URL"],
        "openai": ["OPENAI_BASE_URL"],
        "anthropic": ["ANTHROPIC_BASE_URL"]
      },
      "tokenVariables": {
        "qwen": ["OPENAI_API_KEY"],
        "openai": ["OPENAI_API_KEY"],
        "anthropic": ["ANTHROPIC_API_KEY"],
        "google": ["GEMINI_API_KEY"]
      },
      "accountMethods": ["qwen-oauth", "qwen-subscription", "openai"]
    },
    {
      "id": "bob",
      "providers": ["bob", "openai", "anthropic", "google"],
      "homeVariables": {},
      "environment": {},
      "setup": [
        {
          "path": ".bob/settings/settings.json",
          "content": "{\"licenseConsent\":true,\"bobShell\":{\"autoUpdate\":false}}\n"
        }
      ],
      "baseUrlVariables": {
        "bob": ["BOB_GATEWAY_URL"]
      },
      "tokenVariables": {
        "bob": ["BOB_API_KEY"]
      },
      "accountMethods": ["sso"]
    }
  ]
}
