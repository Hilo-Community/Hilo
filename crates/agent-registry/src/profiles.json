  "agents": [
    {
      "id": "codex-acp",
      "providers": ["openai"],
      "homeVariables": {
        "CODEX_HOME": ".codex"
      },
      "environment": {},
      "loginCallbackPorts": [1455],
      "setup": [
        {
          "path": ".codex/config.toml",
          "content": "sandbox_mode = \"danger-full-access\"\napproval_policy = \"never\"\n"
        }
      ],
      "baseUrlVariables": {},
      "tokenVariables": {},
      "accountMethods": ["chat-gpt-device-code"],
      "preferenceDomains": ["com.openai.codex"]
