# Copy to `.env` (gitignored) and fill in real values. Nothing here is read by any test unless
# `DATABASE_URL` is set; without it, the Postgres-backed integration tests skip themselves
# (`tests/lot017_sse_cursor.rs`, `tests/lot017_tenant_isolation.rs`) — see
# docs/en/LOTS/LOT-017.md's "Implementation status" for what has and hasn't been exercised.

DATABASE_URL=postgres://hilo:hilo@localhost:5432/hilo_cloud

OIDC_ISSUER_URL=https://your-issuer.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://cloud.hilo.example.com/v1/auth/callback

AWS_REGION=eu-west-1
ECS_CLUSTER_ARN=arn:aws:ecs:eu-west-1:ACCOUNT_ID:cluster/hilo
ECS_TASK_DEFINITION_ARN=arn:aws:ecs:eu-west-1:ACCOUNT_ID:task-definition/hilo-build:1
ECS_SUBNETS=subnet-aaaa,subnet-bbbb
ECS_SECURITY_GROUP=sg-aaaa
FARGATE_SCRATCH_BUCKET=hilo-fargate-scratch

R2_ACCOUNT_ID=
R2_BUCKET=hilo-publish-artifacts
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=hilo-app

LISTEN_ADDR=0.0.0.0:8080
